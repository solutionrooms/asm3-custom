# ASM3 Version Control
ASM3_VERSION=50

# Database Configuration
ASM3_DBTYPE=POSTGRESQL
ASM3_DBHOST=postgres
ASM3_DBPORT=5432
ASM3_DBNAME=asm3
ASM3_DBUSERNAME=asm3
ASM3_DBPASSWORD=asm3_production_password_change_me

# Application URLs (CHANGE THESE)
ASM3_BASE_URL=https://your-domain.com
ASM3_SERVICE_URL=https://your-domain.com/service

# Application Configuration
ASM3_DEBUG=false
ASM3_LOGLEVEL=INFO

# Email Configuration (Gmail SMTP example - CHANGE THESE)
ASM3_ADMIN_EMAIL=admin@your-domain.com
ASM3_FROM_ADDRESS=noreply@your-domain.com
ASM3_SMTP_HOST=smtp.gmail.com
ASM3_SMTP_PORT=587
ASM3_SMTP_USERNAME=your-email@gmail.com
ASM3_SMTP_PASSWORD=your-gmail-app-password
ASM3_SMTP_TLS=true
ASM3_USE_SENDMAIL=false

# Custom Configuration
CUSTOM_FEATURE_ENABLED=true
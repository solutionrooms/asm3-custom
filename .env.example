# ASM3 Version Control
ASM3_VERSION=50
ASM3_ROLLUP_JS=true

# Database Configuration
ASM3_DBTYPE=POSTGRESQL
ASM3_DBHOST=postgres
ASM3_DBPORT=5432
ASM3_DBNAME=asm3
ASM3_DBUSERNAME=asm3
ASM3_DBPASSWORD=asm3_production_password_change_me

# Application URLs (CHANGE THESE)
ASM3_BASE_URL=https://your-domain.com
ASM3_SERVICE_URL=https://your-domain.com/service

# Application Configuration
ASM3_DEBUG=false
ASM3_LOGLEVEL=INFO

# Email Configuration (Gmail SMTP example - CHANGE THESE)
ASM3_ADMIN_EMAIL=admin@your-domain.com
ASM3_FROM_ADDRESS=noreply@your-domain.com
ASM3_SMTP_HOST=smtp.gmail.com
ASM3_SMTP_PORT=587
ASM3_SMTP_USERNAME=your-email@gmail.com
ASM3_SMTP_PASSWORD=your-gmail-app-password
ASM3_SMTP_TLS=true
ASM3_USE_SENDMAIL=false

# Custom Configuration
CUSTOM_FEATURE_ENABLED=true

# DBFS / S3 Storage Configuration
# Storage backend: database | file | s3
ASM3_DBFS_STORE=database

# S3 settings (used when ASM3_DBFS_STORE=s3)
# For AWS, leave endpoint blank to use default; for S3-compatible providers set the endpoint URL
# Best practice: use IAM role/instance credentials in production and leave keys blank.
ASM3_DBFS_S3_BUCKET=your-s3-bucket-name
ASM3_DBFS_S3_ACCESS_KEY_ID=
ASM3_DBFS_S3_SECRET_ACCESS_KEY=
ASM3_DBFS_S3_ENDPOINT_URL=

# Optional: write a copy to a backup S3 as well
ASM3_DBFS_S3_BACKUP_BUCKET=
ASM3_DBFS_S3_BACKUP_ACCESS_KEY_ID=
ASM3_DBFS_S3_BACKUP_SECRET_ACCESS_KEY=
ASM3_DBFS_S3_BACKUP_ENDPOINT_URL=

# Optional: on-read migration from previous S3
ASM3_DBFS_S3_MIGRATE_BUCKET=
ASM3_DBFS_S3_MIGRATE_ACCESS_KEY_ID=
ASM3_DBFS_S3_MIGRATE_SECRET_ACCESS_KEY=
ASM3_DBFS_S3_MIGRATE_ENDPOINT_URL=

# Backup mirroring to S3 (external cron)
# Enable to upload created pg_dump archives to S3 after maintenance
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=your-backup-bucket-name
# Optional: prefix/folder within the bucket (no leading slash)
BACKUP_S3_PREFIX=asm3/backups
# Optional: for AWS set region; for S3-compatible set endpoint URL (e.g., https://nyc3.digitaloceanspaces.com)
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT_URL=
# Optional: credentials (prefer IAM role/profile on the host); leave blank to use default awscli profile/role
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ASM3 Configuration Template
# This file uses environment variable substitution

# Base URLs
base_url = ${ASM3_BASE_URL}
service_url = ${ASM3_SERVICE_URL}

# Locale and timezone settings
locale = en
timezone = 0

# Logging configuration
log_location = stderr
log_debug = ${ASM3_DEBUG}

# Development settings
autoreload = true
debug_mode = ${ASM3_DEBUG}

# JavaScript optimization (rollup bundles reduce first-load latency)
minify_js = false
rollup_js = ${ASM3_ROLLUP_JS}

# Database configuration
db_type = ${ASM3_DBTYPE}
db_host = ${ASM3_DBHOST}
db_port = ${ASM3_DBPORT}
db_username = ${ASM3_DBUSERNAME}
db_password = ${ASM3_DBPASSWORD}
db_name = ${ASM3_DBNAME}

# Deployment settings
deployment_type = wsgi
session_secure_cookie = false

# File storage
# Use env var to control DBFS storage mode (database|file|s3)
dbfs_store = ${ASM3_DBFS_STORE}

# S3 storage configuration (used when dbfs_store = s3)
# If keys are empty, the app will fall back to instance/role or ~/.aws/credentials
dbfs_s3_bucket = ${ASM3_DBFS_S3_BUCKET}
dbfs_s3_access_key_id = ${ASM3_DBFS_S3_ACCESS_KEY_ID}
dbfs_s3_secret_access_key = ${ASM3_DBFS_S3_SECRET_ACCESS_KEY}
# For AWS, leave blank; for S3-compatible providers set endpoint (e.g., https://s3.eu-west-1.amazonaws.com or https://nyc3.digitaloceanspaces.com)
dbfs_s3_endpoint_url = ${ASM3_DBFS_S3_ENDPOINT_URL}

# Optional: synchronous backup to a second S3 (leave blank to disable)
dbfs_s3_backup_bucket = ${ASM3_DBFS_S3_BACKUP_BUCKET}
dbfs_s3_backup_access_key_id = ${ASM3_DBFS_S3_BACKUP_ACCESS_KEY_ID}
dbfs_s3_backup_secret_access_key = ${ASM3_DBFS_S3_BACKUP_SECRET_ACCESS_KEY}
dbfs_s3_backup_endpoint_url = ${ASM3_DBFS_S3_BACKUP_ENDPOINT_URL}

# Optional: migrate-on-read from previous provider (leave blank to disable)
dbfs_s3_migrate_bucket = ${ASM3_DBFS_S3_MIGRATE_BUCKET}
dbfs_s3_migrate_access_key_id = ${ASM3_DBFS_S3_MIGRATE_ACCESS_KEY_ID}
dbfs_s3_migrate_secret_access_key = ${ASM3_DBFS_S3_MIGRATE_SECRET_ACCESS_KEY}
dbfs_s3_migrate_endpoint_url = ${ASM3_DBFS_S3_MIGRATE_ENDPOINT_URL}

# Error handling
email_errors = false
admin_email = ${ASM3_ADMIN_EMAIL}

# SMTP Settings
from_address = ${ASM3_FROM_ADDRESS}
smtp_host = ${ASM3_SMTP_HOST}
smtp_port = ${ASM3_SMTP_PORT}
smtp_username = ${ASM3_SMTP_USERNAME}
smtp_password = ${ASM3_SMTP_PASSWORD}
smtp_tls = ${ASM3_SMTP_TLS}
use_sendmail = ${ASM3_USE_SENDMAIL}

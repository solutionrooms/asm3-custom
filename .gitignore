# Environment files
.env
.env.local
.env.production
.env_animaltracker

# Database backups
backup_*.sql
*.dump
backups/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Docker volumes (if using bind mounts)
data/
volumes/

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Python bytecode (if any gets created)
__pycache__/
*.pyc
*.pyo

# Custom local files
local/
private/

# SSL certificates (if you add them)
*.pem
*.key
*.crt

# Custom configuration that shouldn't be shared
customizations/sitedefs.py.local

# Generated nginx config
nginx-processed.conf

raw_data/

# Generated JavaScript bundles (rebuilt via make js-rebundle)
src/static/js/bundle/rollup*.js
src/static/js/bundle/*.map
src/static/js/compat/
